@model Health_Hive_Project_2024.Models.Patient

@{
    ViewData["Title"] = "Patient Registration";
}

<h1 class="text-center mb-4">Patient Registration</h1>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4 shadow-sm" style="border-radius: 15px;">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="PatientIDNumber" class="control-label">
                                <img src="~/images/patient id.png" alt="Patient ID Icon" style="width:20px; height:20px; margin-right:5px;">
                                Patient ID Number:
                            </label>
                            <input asp-for="PatientIDNumber" class="form-control rounded" id="PatientIDNumber" value="@Model.PatientIDNumber" />
                            <span asp-validation-for="PatientIDNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="control-label">
                                <img src="~/images/patient surname.png" alt="Surgeon Icon" style="width:20px; height:20px; margin-right:5px;">
                                Patient Name:
                            </label>
                            <input asp-for="Name" class="form-control rounded" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Surname" class="control-label">
                                <img src="~/images/patient surname.png" alt="Surgeon Icon" style="width:20px; height:20px; margin-right:5px;">
                                Patient Surname:
                            </label>
                            <input asp-for="Surname" class="form-control rounded" />
                            <span asp-validation-for="Surname" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="DateOfBirth" class="control-label">
                                <img src="~/images/Calendar.png" alt="Date of Birth Icon" style="width:20px; height:20px; margin-right:5px;">
                                Date Of Birth:
                            </label>
                            <input asp-for="DateOfBirth" class="form-control rounded" id="DateOfBirth" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Address" class="control-label">
                                    <img src="~/images/address information.png" alt="Surgeon Icon" style="width:20px; height:20px; margin-right:5px;">
                                    Address:
                                </label>
                                <input asp-for="Address" class="form-control rounded" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ContactNumber" class="control-label">
                                    <img src="~/images/contact number.png" alt="Surgeon Icon" style="width:20px; height:20px; margin-right:5px;">
                                    Contact Number:
                                </label>
                                <input asp-for="ContactNumber" class="form-control rounded" />
                                <span asp-validation-for="ContactNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="EmailAddress" class="control-label">
                                    <img src="~/images/email.png" alt="Surgeon Icon" style="width:20px; height:20px; margin-right:5px;">
                                    Email Address:
                                </label>
                                <input asp-for="EmailAddress" class="form-control rounded" />
                                <span asp-validation-for="EmailAddress" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Gender" class="control-label">
                                    <img src="~/images/gender.png" alt="Gender Icon" style="width:20px; height:20px; margin-right:5px;">
                                    Gender:
                                </label>
                                <!-- Container with rounded corners -->
                                <div class="p-3 border rounded" style="border-radius: 15px;">
                                    <div class="form-check">
                                        <input type="radio" asp-for="Gender" value="Male" class="form-check-input" id="genderMale" />
                                        <label class="form-check-label" for="genderMale">Male</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" asp-for="Gender" value="Female" class="form-check-input" id="genderFemale" />
                                        <label class="form-check-label" for="genderFemale">Female</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" id="OtherGender" name="Gender" value="Other" class="form-check-input" />
                                        <label class="form-check-label" for="OtherGender">Other</label>
                                    </div>
                                    <input type="text" id="OtherGenderText" name="OtherGenderText" class="form-control rounded mt-2" style="display:none;" placeholder="Please specify" />
                                </div>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>



                    </div>

                    <div class="text-center">
                        <input type="submit" value="Register Patient" class="btn btn-primary rounded px-4 py-2" />
                    </div>
            </form>
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    <a asp-action="Index1" class="btn btn-secondary rounded px-4 py-2">Back</a>
</div>


<!-- Successfull registration Patient Modal -->

<div class="modal fade" id="patientModal" tabindex="-1" role="dialog" aria-labelledby="patientModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientModalLabel">Patient Registered Successfully</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Hidden input to store the patient ID -->
                <input type="hidden" id="hiddenPatientID" value="" />

                <!-- Modal message -->
                The patient has been registered successfully. Would you like to book a surgery for this patient?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="bookSurgeryButton">Book Surgery</button>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap Bundle with Popper -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!--Java script for Gender/Id number-->
    <script>
        // Function to handle showing/hiding the "Other" gender input field
        $(document).ready(function () {
            $("input[name='Gender']").change(function () {
                if ($(this).val() === 'Other') {
                    $("#OtherGenderText").show(); // Show the input field
                } else {
                    $("#OtherGenderText").hide(); // Hide the input field
                }
            });
        });

        $("form").on("submit", function (event) {
            event.preventDefault(); // Prevent the default form submission

            var idNumber = $("#PatientIDNumber").val();
            if (!/^\d{13}$/.test(idNumber)) {
                alert("ID Number must be 13 digits long.");
                return; // Exit if the ID number is invalid
            }

            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        // Store the patientID in the hidden field inside the modal
                        $('#hiddenPatientID').val(response.patientID);

                        // Show the modal after successful registration
                        $('#patientModal').modal('show');
                    } else {
                        alert('Failed to create patient.');
                    }
                },
                error: function () {
                    alert('An error occurred while submitting the form.');
                }
            });
        });

        // Event handler for the "Book Surgery" button in the modal
        $('#bookSurgeryButton').click(function () {
            // Get the patientID from the hidden field
            var patientID = $('#hiddenPatientID').val();

            // Redirect to the Surgery Booking page with the patientID
            window.location.href = `/SurgeryBookings/Create?patientID=${patientID}`;
        });
    </script>
    <!--Javascript for auto selecting date of birth-->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            function updateDateOfBirth() {
                var idNumber = $("#PatientIDNumber").val();

                // Check if the ID number is long enough to process
                if (idNumber.length >= 6) {
                    // Extract year, month, and day from the ID number
                    var year = idNumber.substring(0, 2);
                    var month = idNumber.substring(2, 4);
                    var day = idNumber.substring(4, 6);

                    // Determine if the year is in the 1900s or 2000s
                    var currentYear = new Date().getFullYear();
                    var currentCentury = Math.floor(currentYear / 100) * 100;
                    var fullYear = (parseInt(year) >= 0 && parseInt(year) <= 23) ? currentCentury + parseInt(year) : (currentCentury - 100) + parseInt(year);

                    // Create the Date of Birth string in yyyy-MM-dd format
                    var dateOfBirth = fullYear + "-" + month + "-" + day;

                    // Update the Date of Birth field
                    $("#DateOfBirth").val(dateOfBirth);
                } else {
                    // Clear the Date of Birth field if ID number is too short
                    $("#DateOfBirth").val("");
                }
            }

            // Call updateDateOfBirth on page load
            updateDateOfBirth();

            // If the PatientIDNumber is updated dynamically, call updateDateOfBirth again
            // This is an example if the ID is updated after some action
            $(document).on('change', '#PatientIDNumber', function () {
                updateDateOfBirth();
            });
        });
    </script>
}










