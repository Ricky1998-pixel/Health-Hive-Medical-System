@model IEnumerable<VitalModel>

@foreach (var vt in Model)
{
    bool isWithinRange = int.TryParse(vt.ReadingValue, out int reading) &&
    reading >= vt.GetNormalRange.MinValue && reading <= vt.GetNormalRange.MaxValue;

    string rangeStatus = isWithinRange ? "Within Range" : "Over/Under Range";
    string statusClass = isWithinRange ? "text-success" : "text-danger"; // Green if normal, red if danger
    <tr>
        <td>
            <div class="d-flex px-2">
                <div class="my-auto">
                    <h6 class="mb-0 text-sm">@vt.GetNormalRange.VitalName</h6>
                </div>
            </div>
        </td>
        <td>
            <div class="d-flex px-2">
                <div class="my-auto">
                    <h6 class="mb-0 text-sm">@vt.ReadingValue</h6>
                </div>
            </div>
        </td>
        <td>
            <div class="d-flex px-2">
                <div class="my-auto">
                    <h6 class="mb-0 text-sm">@vt.TimeStamp</h6>
                </div>
            </div>
        </td>
        <td>
            <div class="d-flex px-2">
                <div class="my-auto">
                    <h6 class="mb-0 text-sm @statusClass">@rangeStatus</h6>
                </div>
            </div>
        </td>
    </tr>
}
