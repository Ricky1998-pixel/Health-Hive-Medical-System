<script>
    document.getElementById('addMedicationForm').addEventListener('submit', function (event) {
        event.preventDefault(); // Prevent default form submission

        var formData = new FormData(this); // Gather form data

        fetch('/OrderMedication/AddMedication', {
            method: 'POST',
            body: formData,
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Medication added successfully:', data.message);

                    // Close the modal using Bootstrap's Modal API
                    var modalElement = document.getElementById('addMedicationModal');
                    var modal = bootstrap.Modal.getInstance(modalElement);
                    modal.hide(); // Close the modal

                    // Redirect to the patient information page
                    if (data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    }
                } else {
                    // Display validation errors
                    var errorMessages = document.getElementById('errorMessages');
                    errorMessages.innerHTML = data.errors.join('<br>');
                    errorMessages.style.display = 'block'; // Show the error messages
                    console.error('Error adding medication:', data.errors);
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
    });
</script>



