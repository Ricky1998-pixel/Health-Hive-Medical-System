        });

        function deleteMedication(medicineStoreId, orderId) {
            if (!medicineStoreId || medicineStoreId === 0) {
                alert("Invalid medication ID");
                return;
            }

            fetch(`/ExistingOrders/DeleteMedication?medicineStoreId=${medicineStoreId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Failed to delete medication.');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.message) {
                        alert(data.message);  // Display the result message
                    }

                    if (data.message === "Medication deleted successfully. Please reload to see the changes!") {
                        // After deletion, re-fetch the updated list
                        fetch(`/OrderMedication/GetMedications?OrderMedicationID=${orderId}`)
