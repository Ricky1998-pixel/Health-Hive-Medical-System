        }

        function updateModalContent(data, orderId) {
            var tableBody = document.getElementById('medicationListContent');
            tableBody.innerHTML = '';  // Clear the previous content

            if (data.length > 0) {
                var medicationListHtml = `
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Medication Name</th>
                                <th>Quantity</th>
                                <th>Note</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>`;

                // Loop through the updated medications list
                data.forEach((item, index) => {
                    medicationListHtml += `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${item.medicationName}</td>
                            <td>${item.quantity}</td>
                            <td>${item.note}</td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm delete-medication-btn"
                                        data-id="${item.medicineStoreId}" data-order-id="${orderId}">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>`;
                });

                medicationListHtml += `</tbody></table>`;
                tableBody.innerHTML = medicationListHtml;  // Inject new content into the modal

                // Re-attach event listeners to the new delete buttons
                var deleteButtons = document.querySelectorAll('.delete-medication-btn');
                deleteButtons.forEach(btn => {
                    btn.addEventListener('click', function () {
                        var medicineStoreId = this.getAttribute('data-id');
                        var orderId = this.getAttribute('data-order-id');
                        if (confirm("Are you sure you want to delete this medication?")) {
                            deleteMedication(medicineStoreId, orderId);
                        }
                    });
                });
            } else {
                tableBody.innerHTML = '<p>No medications found for this order.</p>';
            }
        }



    </script>

