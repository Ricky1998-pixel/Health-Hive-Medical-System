@{
}
<div class="row justify-content-center" style="margin-top:10%">
    <div class="card">
        <div class="row card-body">
            <div class="col-md-4">
                <a href="#">
                    <div class="card">
                        <div class="card-body">
                            <div class="row justify-content-center">
                                <img src="~/css/icons/hospital.png" style="width:150px" />
                            </div>
                            <div class="row justify-content-center">
                                <h5 class="text-center">
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                                        99+
                                    </span> @* COUNT *@Admitted Patients
                                </h5>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a asp-action="Index" asp-controller="SurgeryBookings">
                    <div class="card">
                        <div class="card-body">
                            
                            <div class="row justify-content-center">
                                <img src="~/css/icons/medical-appointment.png" style="width:150px" />
                            </div>
                            <div class="row justify-content-center">
                                <h5 class="text-center">
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        99+
                                    </span> @* COUNT *@Booked Surgeries
                                </h5>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="#">
                    <div class="card">
                        <div class="card-body">
                            <div class="row justify-content-center">
                                <img src="~/css/icons/vital-signs.png" style="width:150px" />
                            </div>
                            <div class="row justify-content-center">
                                <h5 class="text-center">Track Vitals</h5>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

        </div>
        <div class="row card-body">
            <div class="col-md-4">
                <a href="#">
                    <div class="card">
                        <div class="card-body">
                            <div class="row justify-content-center">
                                <img src="~/css/icons/test.png" style="width:150px" />
                            </div>
                            <div class="row justify-content-center">
                                <h5 class="text-center">Administer Medication</h5>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="#">
                    <div class="card">
                        <div class="card-body">
                           
                            <div class="row justify-content-center">
                                <img src="~/css/icons/discharge.png" style="width:150px" />
                            </div>
                            <div class="row justify-content-center">
                                <h5 class="text-center">
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        99+
                                    </span> @* COUNT *@Discharge Patient
                                </h5>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="#">
                    <div class="card">
                        <div class="card-body">
                            <div class="row justify-content-center">
                                <img src="~/css/icons/folder.png" style="width:150px" />
                            </div>
                            <div class="row justify-content-center">
                                <h5 class="text-center">Patient File</h5>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

        </div>

    </div>
</div>
