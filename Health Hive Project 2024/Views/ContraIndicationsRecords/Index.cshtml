@model IEnumerable<Health_Hive_Project_2024.Models.ContraIndicationsRecords>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Condition)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertMessage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Condition.ConditionID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ingredient.IngredientName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AlertMessage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AlertType)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ContraIndicationID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ContraIndicationID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ContraIndicationID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
