<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">


<style>
    .modal-content {
        border-radius: 15px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .form-control {
        border-radius: 15px;
    }

    .list-group-item {
        border: none;
        border-radius: 10px;
        margin-bottom: 5px;
    }

        .list-group-item:hover {
            background-color: #f1f1f1;
        }

    #searchMedication {
        border-radius: 15px;
        margin-bottom: 10px;
    }

    .rounded-container {
        border: 1px solid #ddd; /* Border color */
        border-radius: 15px; /* Round the corners */
        padding: 20px; /* Add padding inside the container */
        background-color: #fff; /* Optional: Set a background color */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Optional: Add shadow for better appearance */
    }
</style>

<hr />
<div class="container my-5">
    <div class="row">
        <!-- Form Container -->
        <div class="col-md-8">
            <div class="rounded-container p-4 shadow-sm bg-white">
                <h2 class="mb-4 text-center">Order Medication</h2>
                <hr />
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group">
                        <label asp-for="PatientID" class="control-label">Select Patient:</label>
                        <select asp-for="PatientID" class="form-control" asp-items="ViewBag.PatientId"></select>
                    </div>
                    <div id="patientDetailsContainer" class="mb-3"></div>
                    <input type="hidden" id="PatientID" name="PatientID" />

                    <div class="form-group">
                        <label asp-for="IsUrgent" class="control-label">
                            Urgent Status:
                        </label>
                        <div>
                            <input asp-for="IsUrgent" type="checkbox" id="urgent-checkbox" class="form-check-input" />
                            
                        </div>
                        <span asp-validation-for="IsUrgent" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PharmacistID" class="control-label">
                            Pharmacist:
                        </label>
                        <select asp-for="PharmacistID" class="form-control" asp-items="ViewBag.PharmacistID" id="pharmacist-select"></select>
                    </div>

                    <!-- Medication Table -->
                    <div class="rounded-container mt-4 p-3 bg-light border">
                        <h5>Selected Medications</h5>
                        <table class="table table-bordered" id="medicationsTable">
                            <thead>
                                <tr>
                                    <th>Medication</th>
                                    <th>Quantity</th>
                                    <th>Instructions</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <input type="hidden" name="medicationIds" id="medicationIds" />
                    <input type="hidden" name="quantities" id="quantities" />
                    <input type="hidden" name="instructions" id="instructions" />

                    <button type="button" class="btn btn-success mt-3" data-bs-toggle="modal" data-bs-target="#medicationModal">
                        Add Medications
                    </button>

                    <div class="form-group mt-4 text-center">
                        <input type="submit" value="Prescribe" class="btn btn-primary btn-lg" />
                    </div>
                </form>
            </div>
        </div>

        <!-- Right Side Details -->
        <div class="col-md-4">
            <div class="rounded-container p-3 border shadow-sm bg-light">
                <div class="wrapper-light-blue">
                    <h5 class="text-center">Patient Details:</h5>
                    <div id="patient-details-container">
                        <!-- Patient details will be populated here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Medication Modal -->
<div class="modal fade" id="medicationModal" tabindex="-1" aria-labelledby="medicationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="medicationModalLabel">Select Medications</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Search Medication -->
                <input type="text" id="medicationSearch" class="form-control" placeholder="Search medications..." />
                <ul id="medicationList" class="list-group mt-3" style="max-height: 300px; overflow-y: auto;">
                    <!-- Populate from ViewBag -->
                    @if (ViewBag.MedicationList != null)
                    {
                        foreach (var medication in ViewBag.MedicationList as List<Health_Hive_Project_2024.Models.MedicationRecords>)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <input type="checkbox" value="@medication.MedicationID" data-name="@medication.MedicationName" />
                                <span>@medication.MedicationName</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item">No medications available</li>
                    }
                </ul>

                <!-- Input Details -->
                <div id="detailsSection" class="mt-4">
                    <div class="mb-3">
                        <label for="quantityInput" class="form-label">Quantity</label>
                        <input type="number" id="quantityInput" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="instructionsInput" class="form-label">Instructions</label>
                        <input type="text" id="instructionsInput" class="form-control" />
                    </div>
                    <button type="button" id="addMedicationBtn" class="btn btn-primary">Add Medication</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="prescriptionSuccessModal" tabindex="-1" aria-labelledby="prescriptionSuccessModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Medication Ordered</h5>
                <button type="button" class="btn-close" data-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Medication Ordered successfully!
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
     @*            <a type="button" class="btn btn-primary" data-dismiss="modal">Ok</a> *@
            </div>

        </div>
    </div>
</div>
<scipt>

</scipt>





@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {


            // Function to handle the search logic
            function searchPatient() {
                var patientIdNumber = $('#patientIdSearch').val();
                $.ajax({
                    url: '@Url.Action("SearchPatient", "OrderMedication")',
                    type: 'GET',
                    data: { patientIdNumber: patientIdNumber },
                    success: function (result) {
                        $('#patient-details-container').html(result);
                        var selectedPatientId = $('#selectedPatientId').val();
                        if (selectedPatientId) {
                            $('#PatientID').val(selectedPatientId);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                    }
                });
            }

            // Attach click event to the search button
            $('#searchPatientBtn').on('click', function () {
                searchPatient();
            });

            // Attach keypress event to the input field
            $('#patientIdSearch').on('keypress', function (e) {
                if (e.which === 13) { // Check if Enter key is pressed
                    e.preventDefault(); // Prevent default form submission
                    searchPatient();
                }
            });
            // Update selected date when the date input changes
            $('#date-input').on('change', function () {
                var selectedDate = $(this).val();
                $('#selected-date').text(selectedDate);
            });

            // Update selected status when the status select changes
            $('#urgent-checkbox').on('change', function () {
                var selectedStatus = $(this).val();
                $('#selected-status').text(selectedStatus);
            });
            // Update selected pharmacist when the pharmacist select changes
            $('#pharmacist-select').on('change', function () {
                var selectedPharmacist = $(this).val();
                $('#selected-pharmacist').text(selectedPharmacist);
            });
            $('#medication-select').change(function () {
                var selectedValue = $(this).val();
                var selectedText = $(this).find("option:selected").text();
                $('#selected-medication').text(selectedText);
            });
            // Update selected quantity when the quantity input changes
            $('#quantity-input').on('change', function () {
                var selectedQuantity = $(this).val();
                $('#selected-quantity').text(selectedQuantity);
            });
            // Update selected instructions when the instructions input changes
            $('#instructions-input').on('change', function () {
                var selectedInstructions = $(this).val();
                $('#selected-instructions').text(selectedInstructions);
            });
         
            // Update Urgent check box
            $('#urgent-checkbox').on('change', function () {
                var isUrgent = $(this).is(':checked') ? 'Yes' : 'No';
                $('#selected-urgent').text(isUrgent);
            });

        });
    </script>
}

            <script>
    $(document).ready(function () {
        // Handle Patient Search
        $('#searchPatientBtn').click(function () {
            var patientId = $('#patientIdSearch').val();
            if (patientId) {
                // Make an AJAX request to get patient details
                $.ajax({
                    url: '/Prescription/GetPatientDetails',
                    type: 'GET',
                    data: { id: patientId },
                    success: function (data) {
                        if (data) {
                            $('#patientDetailsContainer').html(`
                                <p><strong>Name:</strong> ${data.name}</p>
                                <p><strong>Age:</strong> ${data.age}</p>
                                <p><strong>Address:</strong> ${data.address}</p>
                            `);
                            $('#PatientID').val(data.id);
                        } else {
                            $('#patientDetailsContainer').html('<p>No patient found</p>');
                        }
                    },
                    error: function () {
                        alert('fetching patient details.');
                    }
                });
            } else {
                alert('Please enter a valid Patient ID.');
            }
        });

        // Handle adding medication to the table
        $('#addMedicationBtn').click(function () {
            var selectedMedications = $('#medicationList input[type="checkbox"]:checked');
            var medicationsHtml = '';
            var isValid = true; // Flag to check if form is valid

            selectedMedications.each(function () {
                var medicationId = $(this).val();
                var medicationName = $(this).data('name');
                var quantity = $('#quantityInput').val();
                var instruction = $('#instructionsInput').val();

                // Check if quantity and instruction are provided
                if (quantity && instruction) {
                    // Append to the table
                    medicationsHtml += `
                    <tr>
                        <td>${medicationName}</td>
                        <td>${quantity}</td>
                        <td>${instruction}</td>
                        <td>
                            <input type="hidden" name="MedicationIds" value="${medicationId}">
                            <input type="hidden" name="Quantities" value="${quantity}">
                            <input type="hidden" name="Instructions" value="${instruction}">
                            <button type="button" class="btn btn-danger btn-sm remove-medication">Remove</button>
                        </td>
                    </tr>
                `;
                } else {
                    alert('Please provide quantity and instructions.');
                    isValid = false; // Set flag to false if validation fails
                    return false; // Exit the loop
                }
            });

            // Only update the table and close the modal if the form is valid
            if (isValid) {
                // Update the table
                $('#medicationsTable tbody').append(medicationsHtml);

                // Close the modal
                $('#medicationModal').modal('hide');
            }
        });


        // Handle removing medication from the table
        $('#medicationsTable').on('click', '.remove-medication', function () {
            $(this).closest('tr').remove();
        });

        // Handle form submission
        $('form').submit(function (e) {
            e.preventDefault();
            var formData = $(this).serialize();

            // Make AJAX request to submit the form
            $.ajax({
                url: '/OrderMedication/Create',
                type: 'POST',
                data: formData,
                success: function (data) {
                    if (data.success) {
                        // Show success modal
                        $('#prescriptionSuccessModal').modal('show');
                    } else {
                        alert('There was an issue submitting the prescription.');
                    }
                },
                error: function () {
                    alert('Error submitting the prescription.');
                }
            });
        });
    });

            </script>