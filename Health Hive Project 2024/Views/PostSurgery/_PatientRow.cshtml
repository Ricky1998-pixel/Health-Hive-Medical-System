@model IEnumerable<Health_Hive_Project_2024.Models.Patient>
@{
    int row = 0;
}

@if (Model == null || !Model.Any())
{
    <tr>
        <td colspan="6">No patients found.</td>
    </tr>
}
else
{
    @foreach (var user in Model)
    {
        row++;
        <tr>
            <td>
                <div class="d-flex px-2">
                    <div class="my-auto">
                        <h6 class="mb-0 text-sm">@row</h6>
                    </div>
                </div>
            </td>
            <td>
                <div class="d-flex px-2">
                    <div class="my-auto">
                        <h6 class="mb-0 text-sm">@user.PatientIDNumber</h6>
                    </div>
                </div>
            </td>
            <td>
                <div class="d-flex px-2">
                    <div class="my-auto">
                        <h6 class="mb-0 text-sm">@user.Name</h6>
                    </div>
                </div>
            </td>
            <td>
                <div class="d-flex px-2">
                    <div class="my-auto">
                        <h6 class="mb-0 text-sm">@user.Surname</h6>
                    </div>
                </div>
            </td>
            <td>
                <div class="d-flex px-2">
                    <div class="my-auto">
                        <h6 class="mb-0 text-sm">@user.Gender</h6>
                    </div>
                </div>
            </td>
            <td>
                <div class="d-flex px-2">
                    <div class="my-auto">
                        <a asp-controller="PostSurgery" asp-action="Order" asp-route-Id="@user.PatientID" class="btn btn-primary">Post Notes</a>
                    </div>
                </div>
            </td>
        </tr>
    }

}
