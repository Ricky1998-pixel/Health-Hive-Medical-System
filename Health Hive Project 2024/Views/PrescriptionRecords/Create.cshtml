@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Function to handle the search logic
            function searchPatient() {
                var patientIdNumber = $('#patientIdSearch').val();
                var selectedMedicationIds = $('#medicationIds').val().split(',');

                if (selectedMedicationIds.length === 0 || selectedMedicationIds[0] === "") {
                    $('#alertContainer').html('<div class="alert alert-danger" role="alert">Please select at least one medication before searching for a patient.</div>');
                    return;
                }

                if (!patientIdNumber) {
                    $('#alertContainer').html('<div class="alert alert-danger" role="alert">Please enter a Patient ID number.</div>');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("SearchPatientById", "Patients")',
                    type: 'GET',
                    data: {
                        patientIdNumber: patientIdNumber,
                        medicationIds: selectedMedicationIds.join(',')
                    },
                    success: function (response) {
                        $('#patient-details-container').html(response);

                        // Check for alerts in the response
                        var $response = $(response);
                        var alerts = $response.find('#alertContainer .alert').html();
                        if (alerts) {
                            $('#modal-alerts-body').html(alerts);
                            $('#alertsModal').modal('show');
                        }

                        // Update hidden patient ID if available
                        var patientId = $response.find('#selectedPatientId').val();
                        if (patientId) {
                            $('#PatientID').val(patientId);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                        $('#patient-details-container').html('<p>An error occurred while searching for the patient. Please try again.</p>');
                    }
                });
            }







            // Attach click event to the search button
            $('#searchPatientBtn').on('click', function () {
                searchPatient();
            });

            // Attach keypress event to the input field
            $('#patientIdSearch').on('keypress', function (e) {
                if (e.which === 13) { // Check if Enter key is pressed
                    e.preventDefault(); // Prevent default form submission
                    searchPatient();
                }
            });






            // Update selected date when the date input changes
            $('#date-input').on('change', function () {
                var selectedDate = $(this).val();
                $('#selected-date').text(selectedDate);
            });

            // Update selected status when the status select changes
            $('#status-select').on('change', function () {
                var selectedStatus = $(this).val();
                $('#selected-status').text(selectedStatus);
            });
            // Update selected pharmacist when the pharmacist select changes
            $('#pharmacist-select').on('change', function () {
                var selectedPharmacist = $(this).val();
                $('#selected-pharmacist').text(selectedPharmacist);
            });
            $('#medication-select').change(function () {
                var selectedValue = $(this).val();
                var selectedText = $(this).find("option:selected").text();
                $('#selected-medication').text(selectedText);
            });
            // Update selected quantity when the quantity input changes
            $('#quantity-input').on('change', function () {
                var selectedQuantity = $(this).val();
                $('#selected-quantity').text(selectedQuantity);
            });
            // Update selected instructions when the instructions input changes
            $('#instructions-input').on('change', function () {
                var selectedInstructions = $(this).val();
                $('#selected-instructions').text(selectedInstructions);
            });
            // Update selected surgeon when the surgeon select changes
            $('#surgeon-select').on('change', function () {
                var selectedSurgeon = $(this).val();
                $('#selected-surgeon').text(selectedSurgeon);
            });
            // Update Urgent check box
            $('#urgent-checkbox').on('change', function () {
                var isUrgent = $(this).is(':checked') ? 'Yes' : 'No';
                $('#selected-urgent').text(isUrgent);
            });

        });
    </script>
}
