                    <input asp-for="Vitals[@i].MinValue" class="form-control" type="number" step="any" />
                    <span asp-validation-for="Vitals[@i].MinValue" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Vitals[@i].MaxValue" class="control-label">Maximum Vital Value</label>
                    <input asp-for="Vitals[@i].MaxValue" class="form-control" type="number" step="any" />
                    <span asp-validation-for="Vitals[@i].MaxValue" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Vitals[@i].CurrentValue" class="control-label">Current Vital Value</label>
                    <input asp-for="Vitals[@i].CurrentValue" class="form-control" type="number" step="any" />
                    <span asp-validation-for="Vitals[@i].CurrentValue" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Vitals[@i].DateRecorded" class="control-label">Date Recorded</label>
                    <input asp-for="Vitals[@i].DateRecorded" class="form-control" type="date" />
                    <span asp-validation-for="Vitals[@i].DateRecorded" class="text-danger"></span>
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
 *@