                    <select name="Vitals[@i].VitalName" class="form-control">
                        @foreach (var vitalName in ViewBag.VitalNames as List<string>)
                        {
                            <option value="@vitalName" @(Model.Vitals[i].VitalName != null && Model.Vitals[i].VitalName.Equals(vitalName) ? "selected" : "")>
