@model Health_Hive_Project_2024.Models.TreatmentRecords

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TreatmentRecords</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" id="createForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div id="treatmentFields">
                <div class="treatment-group" data-index="0">
                    <div class="form-group">
                        <label asp-for="TreatmentCode" class="control-label"></label>
                        <input asp-for="TreatmentCode" class="form-control" name="TreatmentCodes[0]" />
                        <span asp-validation-for="TreatmentCode" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="control-label"></label>
                        <input asp-for="Description" class="form-control" name="Descriptions[0]" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <button type="button" id="addTreatment" class="btn btn-secondary">Add Treatment</button>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script>
        var treatmentIndex = 1; // Keep track of the index for dynamic fields

        document.getElementById('addTreatment').addEventListener('click', function () {
            var treatmentFields = document.getElementById('treatmentFields');
            var treatmentGroup = document.createElement('div');
            treatmentGroup.classList.add('treatment-group');
            treatmentGroup.setAttribute('data-index', treatmentIndex);
            treatmentGroup.innerHTML = `
                        <div class="form-group">
                            <label>Treatment Code</label>
                            <input type="text" class="form-control" name="TreatmentCodes[` + treatmentIndex + `]" />
                        </div>
                        <div class="form-group">
                            <label>Description</label>
                            <input type="text" class="form-control" name="Descriptions[` + treatmentIndex + `]" />
                        </div>
                        <button type="button" class="btn btn-danger removeTreatment">Remove</button>
                    `;

            treatmentFields.appendChild(treatmentGroup);

            // Add event listener to the remove button
            treatmentGroup.querySelector('.removeTreatment').addEventListener('click', function () {
                treatmentFields.removeChild(treatmentGroup);
            });

            treatmentIndex++; // Increment index for the next dynamic field
        });

        // Show modal if the success flag is true
        @if (ViewBag.Success != null && ViewBag.Success)
        {
            <text>
                $(document).ready(function () {
                    $('#successModal').modal('show');
                });
            </text>
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<!-- Modal for Success Message -->
<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="successModalLabel">Success</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Treatment codes successfully added to the system.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


