@model Health_Hive_Project_2024.Models.DayHospital

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-center mt-4">Create Day Hospital</h1>

<div class="container mt-5 p-4 rounded shadow" style="background-color: #f8f9fa; max-width: 600px;">
    <h4 class="text-center mb-4">Day Hospital Information</h4>
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-3">
            <label asp-for="HospitalName" class="form-label"></label>
            <input asp-for="HospitalName" class="form-control rounded-pill" />
            <span asp-validation-for="HospitalName" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Address" class="form-control rounded-pill" aria-required="true" placeholder="Address" required />
            <label asp-for="Address">
                <img src="~/images/address.png" alt="Address Icon" class="me-2" style="width: 20px; height: 20px;" />
                Address
            </label>
            <div class="invalid-feedback">Please provide a valid address.</div>
        </div>

        <div class="form-floating mb-3">
            <input id="PostalCode" asp-for="PostalCode" class="form-control rounded-pill" aria-required="true" placeholder="Postal Code" required />
            <label asp-for="PostalCode">
                <img src="~/images/postal code.png" alt="Postal Code Icon" class="me-2" style="width: 20px; height: 20px;" />
                Postal Code
            </label>
            <div class="invalid-feedback">Please provide a valid postal code.</div>
        </div>

        <div class="form-group mb-3">
            <label for="Suburb">
                <img src="~/images/suburb.png" alt="Suburb Icon" class="me-2" style="width: 20px; height: 20px;" />
                Suburb
            </label>
            <select id="Suburb" asp-for="Suburb" class="form-control rounded-pill" aria-required="true" required>
                <option value="">-- Select Suburb --</option>
                <!-- Add options dynamically -->
            </select>
            <div class="invalid-feedback">Please select a suburb.</div>
        </div>

        <div class="form-floating mb-3">
            <input id="City" asp-for="City" class="form-control rounded-pill" aria-required="true" placeholder="City" required />
            <label asp-for="City">
                <img src="~/images/city.png" alt="City Icon" class="me-2" style="width: 20px; height: 20px;" />
                City
            </label>
            <div class="invalid-feedback">Please provide a valid city.</div>
        </div>

        <div class="form-floating mb-3">
            <input id="Province" asp-for="Province" class="form-control rounded-pill" aria-required="true" placeholder="Province" required />
            <label asp-for="Province">
                <img src="~/images/province.png" alt="Province Icon" class="me-2" style="width: 20px; height: 20px;" />
                Province
            </label>
            <div class="invalid-feedback">Please provide a valid province.</div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="HospitalContactNumber" class="form-label"></label>
            <input asp-for="HospitalContactNumber" class="form-control rounded-pill" />
            <span asp-validation-for="HospitalContactNumber" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="HospitalEmaiAddress" class="form-label"></label>
            <input asp-for="HospitalEmaiAddress" class="form-control rounded-pill" />
            <span asp-validation-for="HospitalEmaiAddress" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="PracticeManage" class="form-label"></label>
            <input asp-for="PracticeManage" class="form-control rounded-pill" />
            <span asp-validation-for="PracticeManage" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="PurchaseManagerEmailAddress" class="form-label"></label>
            <input asp-for="PurchaseManagerEmailAddress" class="form-control rounded-pill" />
            <span asp-validation-for="PurchaseManagerEmailAddress" class="text-danger"></span>
        </div>

        <div class="form-group text-center">
            <input type="submit" value="Create" class="btn btn-primary rounded-pill px-5" />
        </div>
    </form>
</div>

<div class="text-center mt-4">
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>


<script>
    document.addEventListener('DOMContentLoaded', () => {
        const postalCodeInput = document.getElementById('PostalCode');
        const suburbDropdown = document.getElementById('Suburb');
        const cityInput = document.getElementById('City');
        const provinceInput = document.getElementById('Province');

        // Data for suburbs, cities, and provinces
        const data = {
            "1200": [
                { suburb: "Kamagugu", city: "Mbombela", province: "Mpumalanga" }
            ],
            "1300": [
                { suburb: "Barberton", city: "Mbombela", province: "Mpumalanga" }
            ],
            "1226": [
                { suburb: "Riverside", city: "Mbombela", province: "Mpumalanga" }
            ],
            "4001": [
                { suburb: "Essenwood", city: "Durban", province: "KwaZulu-Natal" },
                { suburb: "Musgrave", city: "Durban", province: "KwaZulu-Natal" },
                { suburb: "Greyville", city: "Durban", province: "KwaZulu-Natal" },
                { suburb: "Glenmore", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "6025": [
                { suburb: "Bridgemead", city: "Gqeberha", province: "Eastern Cape" }
            ],
            "4051": [
                { suburb: "Kenville", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "6001": [
                { suburb: "Humewood", city: "Gqeberha", province: "Eastern Cape" },
                { suburb: "Algoa Park", city: "Gqeberha", province: "Eastern Cape" },
                { suburb: "Struandale", city: "Gqeberha", province: "Eastern Cape" },
                { suburb: "Summerstrand", city: "Gqeberha", province: "Eastern Cape" }
            ],
            "4091": [
                { suburb: "Cato Manor", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "4052": [
                { suburb: "Bluff", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "6045": [
                { suburb: "Cotswold", city: "Gqeberha", province: "Eastern Cape" }
            ],
            "6070": [
                { suburb: "Lorraine", city: "Gqeberha", province: "Eastern Cape" }
            ],
            "4359": [
                { suburb: "Kwamashu", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "4309": [
                { suburb: "Inanda", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "1201": [
                { suburb: "Valencia Park", city: "Mbombela", province: "Mpumalanga" }
            ],
            "4399": [
                { suburb: "Tongaat", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "6020": [
                { suburb: "Malabar", city: "Gqeberha", province: "Eastern Cape" }
            ]
        };

        postalCodeInput.addEventListener('input', () => {
            const postalCode = postalCodeInput.value;
            const infoList = data[postalCode] || [];

            // Clear the dropdown first
            suburbDropdown.innerHTML = '<option value="">-- Select Suburb --</option>';

            if (infoList.length === 1) {
                // If only one suburb is available, auto-fill it
                const info = infoList[0];
                suburbDropdown.innerHTML = `<option value="${info.suburb}">${info.suburb}</option>`;
                suburbDropdown.value = info.suburb;
                cityInput.value = info.city;
                provinceInput.value = info.province;
                suburbDropdown.disabled = true; // Disable dropdown since there's only one option
            } else if (infoList.length > 1) {
                // If multiple suburbs are available, populate the dropdown
                infoList.forEach(info => {
                    const option = document.createElement('option');
                    option.value = info.suburb;
                    option.textContent = info.suburb;
                    suburbDropdown.appendChild(option);
                });
                cityInput.value = infoList[0].city; // Default city
                provinceInput.value = infoList[0].province; // Default province
                suburbDropdown.disabled = false; // Enable dropdown if there are multiple options
            } else {
                // No information available
                cityInput.value = '';
                provinceInput.value = '';
                suburbDropdown.disabled = true; // Disable dropdown if no info is available
            }
        });

        suburbDropdown.addEventListener('change', () => {
            const selectedSuburb = suburbDropdown.value;
            const postalCode = postalCodeInput.value;
            const infoList = data[postalCode] || [];

            const selectedInfo = infoList.find(info => info.suburb === selectedSuburb);
            if (selectedInfo) {
                cityInput.value = selectedInfo.city;
                provinceInput.value = selectedInfo.province;
            } else {
                cityInput.value = '';
                provinceInput.value = '';
            }
        });
    });
</script>