@model IEnumerable<Health_Hive_Project_2024.Models.DayHospital>

@{
    ViewData["Title"] = "Index";
}

@if (TempData["error"] != null)
{
    <div class="row justify-content-center">
        <div class="alert alert-danger">
            @TempData["error"]
        </div>
    </div>
}
@if (TempData["pass"] != null)
{
    <div class="row justify-content-center">
        <div class="alert alert-success">
            @TempData["pass"]
        </div>
    </div>
}

<div class="container">
    <div class="card">
        <div class="card-body">
            <p>
                <a asp-action="Create" class="btn btn-primary">Create New</a>
            </p>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.HospitalName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Address)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.PostalCode)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Suburb)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.City)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Province)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.HospitalContactNumber)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.HospitalEmaiAddress)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.PracticeManage)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.PurchaseManagerEmailAddress)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count() == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-danger text-center">
                                    No Data Found
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.HospitalName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Address)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PostalCode)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Suburb)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.City)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Province)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.HospitalContactNumber)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.HospitalEmaiAddress)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PracticeManage)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PurchaseManagerEmailAddress)
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.HospitalID" class="btn btn-sm btn-outline-secondary">Edit</a> |
                                        <a asp-action="Details" asp-route-id="@item.HospitalID" class="btn btn-sm btn-outline-secondary">Details</a> |
                                        <a asp-action="Delete" asp-route-id="@item.HospitalID" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


