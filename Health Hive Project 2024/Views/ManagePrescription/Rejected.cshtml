@model IEnumerable<Health_Hive_Project_2024.Models.OrderMedications>

@{
    ViewData["Title"] = "Index";
    var groupedByPatient = Model.Where(A => A.Status == OrderStatus.Rejected).GroupBy(p => p.PatientID);
}

<link rel="stylesheet" type="text/css" href="~/css/Important-blink.css">
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f4f4f9;
    }

    .card {
        width: 100%;
        max-width: 1200px;
        margin: 20px auto;
        border-radius: 20px;
        background-color: #ffffff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-body {
        padding: 20px;
    }

    .form-control, .btn {
        border-radius: 25px;
    }

    .table th, .table td {
        padding: 1rem;
        text-align: center;
    }

    .btn-primary:hover {
        background-color: #5a6268;
    }

    .rounded-container {
        padding: 10px;
        background-color: #f8f9fa;
        margin-bottom: 15px;
        border: 1px solid #dee2e6;
        border-radius: 15px;
    }

    .blinking-icon {
        font-size: 1.2em;
        animation: blink 1s infinite;
    }

    .modal-content {
        border-radius: 15px;
    }
</style>

<div class="card">
    <div class="card-body">
        <form asp-action="Search" method="post">
            <div class="row justify-content-end">
                <div class="col-md-8">
                    <input type="text" autocomplete="off" placeholder="Patient ID Number" name="patientId" class="form-control" maxlength="13">
                </div>
                <div class="col-md-2">
                    <input type="submit" value="Search" class="btn btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>

@if (groupedByPatient.Any())
{
    @foreach (var patientGroup in groupedByPatient)
    {
        var patient = patientGroup.FirstOrDefault()?.Patient;

        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title">
                    @patient.Name @patient.Surname (@patient.PatientIDNumber)
                </h5>
                <div class="alert alert-danger mt-4" role="alert">
                    <strong>Note:</strong> Order Has been Rejected!
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Ordered by</th>
                            <th>Date</th>
                            <th>Reject Reason</th>
                            <th>Medications</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prescription in patientGroup)
                        {
                            <tr>
                                <!-- Conditionally render the radio button only if the patient has more than one record -->
                                <td>
                                    @if (patientGroup.Count() > 1)
                                    {
                                        <input type="radio" name="selectedPrescription" value="@prescription.OrderMedicationID" class="form-check-input">
                                    }
                                </td>
                                <td>@prescription.GetAnaesthesiologist.Name</td>
                                <td>@prescription.Date.ToString("dd-MM-yyyy")</td>
                                <td>
                                   @prescription.Instructions
                                </td>
                                <td>
                                    <div class="rounded-container">
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Medication</th>
                                                    <th>Quantity</th>
                                                    <th>Instructions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var med in prescription.GetMedicationData)
                                                {
                                                    <tr>
                                                        <td>@med.Medication.MedicationName</td>
                                                        <td>@med.Quantity</td>
                                                        <td>@med.Note</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
              
            </div>
        </div>
    }
}
else
{
    <div class="card mt-4">
        <div class="card-body text-center text-danger">
            No Data Found
        </div>
    </div>
}
<script>
    $(document).ready(function () {
        $("input[name='selectedPrescription']").change(function () {
            var selectedValue = $("input[name='selectedPrescription']:checked").val();
            $("#selectedPrescriptionID").val(selectedValue);
        });
    });
</script>





<div class="text-right mb-3">
    <a href="@Url.Action("Index", "ManagePrescription")" class="btn btn-primary">
        View Order Prescriptions
    </a>
</div>

<div class="text-right mb-3">
    <a href="@Url.Action("Dispensed", "ManagePrescription")" class="btn btn-secondary">
        View Dispensed Prescriptions
    </a>
</div>

<!-- Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content custom-modal">
            <div class="modal-body">
                Modal body content here.
            </div>
        </div>
    </div>
</div>


<!-- Modal Structure: Patient Vital History -->
<div class="modal fade" id="patientVitalsModal" tabindex="-1" role="dialog" aria-labelledby="patientVitalsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientVitalsModalLabel">Patient Vital History</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="patientVitalsContent">
                    <!-- Content will be dynamically loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Structure: Patient Medical History -->
<div class="modal fade" id="medicalHistoryModal" tabindex="-1" role="dialog" aria-labelledby="medicalHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="medicalHistoryModalLabel">Patient Medical History</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="patientMedicalHistoryContent">
                    <!-- Content will be dynamically loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>





<!-- Reject Modal -->
@foreach (var item in Model)
{
    <div class="modal fade" id="rejectModal-@item.OrderMedicationID" tabindex="-1" aria-labelledby="rejectModalLabel-@item.OrderMedicationID" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel-@item.OrderMedicationID">Reject Prescription</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="rejectForm-@item.OrderMedicationID" method="post" action="@Url.Action("RejectPrescription", "PrescriptionRecords")">
                        <input type="hidden" name="PrescriptionID" value="@item.OrderMedicationID" />
                        <div class="mb-3">
                            <label for="rejectionReason-@item.OrderMedicationID" class="form-label">Rejection Reason</label>
                            <textarea class="form-control" id="rejectionReason-@item.OrderMedicationID" name="RejectionReason" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-danger">Reject</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .custom-modal {
        border-radius: 15px;
        background-color: #87CEEB;
    }
</style>

<script>
    $(document).ready(function () {
        $('a[data-toggle="modal"]').on('click', function () {
            var target = $(this).data('target');
            var url = $(this).data('url');

            $.ajax({
                url: url,
                type: 'GET',
                success: function (data) {
                    $(target).find('.modal-body').html(data);
                    $(target).modal('show');
                },
                error: function () {
                    console.error('Error loading modal content.');
                }
            });
        });
    });
</script>

<script>

    // Handle click event for 'View Vital History' button
    $(document).on('click', '.showVitals', function (e) {
        e.preventDefault(); // Prevent default link behavior

        var patientId = $(this).data('id'); // Get the patient ID from the button's data attribute

        // Make an AJAX request to fetch the patient vitals
        $.ajax({
            url: '@Url.Action("GetPatientVitals", "PatientVitals")', // Update URL to match your controller and action
            type: 'GET',
            data: { id: patientId },
            success: function (data) {
                // Load the response into the modal body
                $('#patientVitalsContent').html(data);

                // Show the modal
                $('#patientVitalsModal').modal('show');
            },
            error: function (xhr, status, error) {
                console.error('An error occurred:', error);
            }
        });
    });


    // Handle click event for 'View Medical History' button
    $(document).on('click', '.showMedicalHistory', function (e) {
        e.preventDefault(); // Prevent default link behavior

        var patientId = $(this).data('id'); // Get the patient ID from the button's data attribute

        // Make an AJAX request to fetch the patient medical history
        $.ajax({
            url: '@Url.Action("GetPatientMedicalHistory", "MedicalHistories")', // Update URL if needed
            type: 'GET',
            data: { id: patientId },
            success: function (data) {
                // Load the response into the modal body
                $('#patientMedicalHistoryContent').html(data);

                // Show the modal
                $('#medicalHistoryModal').modal('show');
            },
            error: function (xhr, status, error) {
                console.error('An error occurred:', error);
            }
        });
    });

</script>
