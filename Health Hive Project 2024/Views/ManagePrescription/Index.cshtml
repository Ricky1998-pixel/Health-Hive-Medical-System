@model IEnumerable<Health_Hive_Project_2024.Models.OrderMedications>

@{
    ViewData["Title"] = "Index";
    var groupedByPatient = Model.Where(A => A.Status == OrderStatus.Ordered).GroupBy(p => p.PatientID);
}

<link rel="stylesheet" type="text/css" href="~/css/Important-blink.css">
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

<!-- jQuery (required for toastr) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<!-- Toastr JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<style>
    .toast-success {
        background-color: rgba(40, 167, 69, 1) !important; /* Change to a green background */
        opacity: 1 !important; /* Set opacity to 100% */
        color: white !important; /* Ensure the text is white for better contrast */
    }

    .toast-message {
        color: black !important; /* Ensure the text is visible */
    }
</style>
<style>
    body {
        background-color: #f4f4f9;
    }

    .card {
        width: 100%;
        max-width: 1200px;
        margin: 20px auto;
        border-radius: 20px;
        background-color: #ffffff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-body {
        padding: 20px;
    }

    .form-control, .btn {
        border-radius: 25px;
    }

    .table th, .table td {
        padding: 1rem;
        text-align: center;
    }

    .btn-primary:hover {
        background-color: #5a6268;
    }

    .rounded-container {
        padding: 10px;
        background-color: #f8f9fa;
        margin-bottom: 15px;
        border: 1px solid #dee2e6;
        border-radius: 15px;
    }

    .blinking-icon {
        font-size: 1.2em;
        animation: blink 1s infinite;
    }

    .modal-content {
        border-radius: 15px;
    }
</style>
<script>
    $(document).ready(function () {
        var successMessage = '@TempData["SuccessMessage"]';

        // Log the message in the browser's console for debugging
        console.log("Success Message: ", successMessage);

        if (successMessage && successMessage !== '') {
            toastr.success(successMessage, 'Success', {
                positionClass: 'toast-top-right',
                timeOut: 5000
            });
        }
    });
</script>
<div class="card">
    <div class="card-body">
        <form asp-action="SearchPrescription" method="post">
            <div class="row justify-content-end">
                <div class="col-md-8">
                    <input type="text" autocomplete="off" placeholder="Patient ID Number" name="patientId" class="form-control" maxlength="13">
                </div>
                <div class="col-md-2">
                    <input type="submit" value="Search" class="btn btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>

@if (groupedByPatient.Any())
{
    @foreach (var patientGroup in groupedByPatient)
    {
        var patient = patientGroup.FirstOrDefault()?.Patient;

        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title">
                    @patient.Name @patient.Surname (@patient.PatientIDNumber)
                </h5>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Ordered by</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Medications</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prescription in patientGroup)
                        {
                            <tr>
                                <!-- Conditionally render the radio button only if the patient has more than one record -->
                                <td>
                                    @if (patientGroup.Count() > 1)
                                    {
                                        <input type="radio" name="selectedPrescription" value="@prescription.OrderMedicationID" class="form-check-input">
                                    }
                                </td>
                                <td>@prescription.GetAnaesthesiologist.Name</td>
                                <td>@prescription.Date.ToString("dd-MM-yyyy")</td>
                                <td>
                                @*     @prescription.PrescriptionStatus *@
                                    @if (prescription.IsUrgent)
                                    {
                                        <span class="blinking-icon text-danger">
                                            <i class="fas fa-exclamation-circle"></i>
                                        </span>
                                    }
                                    else if (!prescription.IsUrgent)
                                    {
                                        <span class="text-success">
                                            <i class="fas fa-check-circle"></i>
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="rounded-container">
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Medication</th>
                                                    <th>Quantity</th>
                                                    <th>Instructions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var med in prescription.GetMedicationData)
                                                {
                                                    <tr>
                                                        <td>@med.Medication.MedicationName</td>
                                                        <td>@med.Quantity</td>
                                                        <td>@med.Note</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

                <div class="text-center">
                    <a href="#" class="btn btn-info btn-sm showAllergies" data-id="@patient.PatientID">View Allergies</a>

                    <a href="#" class="btn btn-info btn-sm showMedicalHistory" data-id="@patient.PatientID">View Current Medication</a>

                    <a href="#" class="btn btn-success btn-sm showVitals" data-id="@patient.PatientID">View Vital History</a>

                   
                        <a asp-controller="ManagePrescription" asp-action="ChangeStatus" asp-route-id="@patientGroup.FirstOrDefault()?.OrderMedicationID" asp-route-PatientID="@patientGroup.FirstOrDefault()?.PatientID" style="background-color:white; box-shadow: 0 4px 6px 0 black;" class="btn btn-shadow-success" asp-route-newStatus="Dispensed">Dispense</a>
              
                    <form id="rejectForm-@patientGroup.FirstOrDefault()?.OrderMedicationID" method="post" style="display:inline;">
                        <input type="hidden" name="PrescriptionID" value="@patientGroup.FirstOrDefault()?.OrderMedicationID" />
                        <button type="button" class="btn btn-danger edit-order-btn"
                                data-bs-toggle="modal" data-bs-target="#editOrderModal"
                                data-order-id="@patientGroup.FirstOrDefault()?.OrderMedicationID" data-patient-id="@patientGroup.FirstOrDefault()?.PatientID"
                                data-instructions="@patientGroup.FirstOrDefault()?.Instructions"
                                title="Edit Order">
                           Reject
                        </button>

                    </form>
                </div>
                <div class="modal fade" id="vitalModal" tabindex="-1" role="dialog" aria-labelledby="vitalModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="vitalModalLabel">Vital History</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <!-- The vital history will be loaded here -->
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal fade" id="medicationModal" tabindex="-1" role="dialog" aria-labelledby="medicationModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="medicationModalLabel">Current Medication</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <!-- The medication history will be loaded here -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal for Editing IsUrgent and Instructions -->
                <div class="modal fade" id="editOrderModal" tabindex="-1" aria-labelledby="editOrderModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="post" action="/ManagePrescription/RejectOrder">
                                <input type="hidden" value="@patientGroup.FirstOrDefault()?.OrderMedicationID" id="orderId" name="OrderMedicationID">
                                <input type="hidden" id="patientId" name="PatientID" value="@patientGroup.FirstOrDefault()?.PatientID"> <!-- Pass PatientID -->
                                <div class="modal-header">
                                    <h5 class="modal-title" id="editOrderModalLabel">Edit Order</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" id="orderId" name="OrderMedicationID">
                                  
                                    <div class="mb-3">
                                        <label for="instructions" class="form-label">Instructions</label>
                                        <textarea class="form-control" id="instructions" name="Instructions" rows="3"></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="submit" class="btn btn-primary">Save changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card mt-4">
        <div class="card-body text-center text-danger">
            No Data Found
        </div>
    </div>
}
<script>
    $(document).ready(function () {
        $("input[name='selectedPrescription']").change(function () {
            var selectedValue = $("input[name='selectedPrescription']:checked").val();
            $("#selectedPrescriptionID").val(selectedValue);
        });
    });
</script>
<script>
    $(document).on('click', '.showVitals', function (e) {
        e.preventDefault();

        var patientId = $(this).data('id');

        $.ajax({
            url: '@Url.Action("GetVitals", "ManagePrescription")',
            data: { patientId: patientId },
            success: function (data) {
                $('#vitalModal .modal-body').html(data);
                $('#vitalModal').modal('show');
            }
        });
    });
</script>
<script>
    $(document).on('click', '.showAllergies', function (e) {
        e.preventDefault();

        var patientId = $(this).data('id');

        $.ajax({
            url: '@Url.Action("GetAllergies", "ManagePrescription")',
            data: { patientId: patientId },
            success: function (data) {
                $('#allergiesModal .modal-body').html(data);
                $('#allergiesModal').modal('show');
            }
        });
    });
</script>

<script>
    $(document).on('click', '.showMedicalHistory', function (e) {
        e.preventDefault();

        var patientId = $(this).data('id');

        $.ajax({
            url: '@Url.Action("GetMedications", "ManagePrescription")',
            data: { patientId: patientId },
            success: function (data) {
                $('#medicationModal .modal-body').html(data);
                $('#medicationModal').modal('show');
            }
        });
    });
</script>

<script>
    // Handle opening the 'Edit' modal for editing IsUrgent and Instructions
    document.querySelectorAll('.edit-order-btn').forEach(button => {
        button.addEventListener('click', function () {
            var orderId = this.getAttribute('data-order-id');
            var patientId = this.getAttribute('data-patient-id'); // Pass PatientID dynamically if needed

            // Populate the form's hidden input with the OrderMedicationID and PatientID
            document.getElementById('orderId').value = orderId;
            document.getElementById('patientId').value = patientId; // Ensure this hidden input exists

            // Set other values (IsUrgent, Instructions)
         
            document.getElementById('instructions').value = this.getAttribute('data-instructions');
        });
    });

</script>



<div class="text-right mb-3">
    <a href="@Url.Action("Dispensed", "ManagePrescription")" class="btn btn-primary">
        View Dispensed Prescriptions
    </a>
</div>

<div class="text-right mb-3">
    <a href="@Url.Action("Rejected", "ManagePrescription")" class="btn btn-secondary">
        View Rejected Prescriptions
    </a>
</div>

<!-- Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content custom-modal">
            <div class="modal-body">
                Modal body content here.
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="allergiesModal" tabindex="-1" role="dialog" aria-labelledby="allergiesModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="allergiesModalLabel">Allergies</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- The allergies history will be loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Structure: Patient Vital History -->
<div class="modal fade" id="patientVitalsModal" tabindex="-1" role="dialog" aria-labelledby="patientVitalsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientVitalsModalLabel">Patient Vital History</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="patientVitalsContent">
