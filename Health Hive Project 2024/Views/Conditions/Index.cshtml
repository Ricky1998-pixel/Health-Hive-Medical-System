@model IEnumerable<Health_Hive_Project_2024.Models.Condition>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().CODE)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Diagnosis)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CODE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Diagnosis)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ConditionID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ConditionID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ConditionID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
