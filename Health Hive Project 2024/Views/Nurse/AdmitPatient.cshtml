@{
}
@model Patient
<div class="row justify-content-center">
    <div class="card w-75">
        <div class="card-body" id="b-1">
            <h3 class="text-center">Admit Patient</h3>
            <h5 class="">Step 1/4: Patient Info</h5>
            <br />
            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label class="control-label">Name</label>
                        <input id="pat-name" value="@Model.Name" autocomplete="off" type="text" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-name-er">Required field</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Surname</label>
                        <input id="pat-sur" value="@Model.Surname" autocomplete="off" type="text" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-sur-er">Required field</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">ID Number</label>
                        <input type="text" value="@Model.PatientIDNumber" readonly autocomplete="off" id="pat-idnum" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-idnum-er">Invalid ID Number</span>

                    </div>
                    <div class="form-group">
                        <label class="control-label">Address</label>
                        <input type="text" value="@Model.Address" autocomplete="off" id="pat-address" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-address-er">Required field</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Date of Birth</label>
                        <input type="text" value="@Model.DateOfBirth.ToShortDateString()" readonly autocomplete="off" id="pat-dob" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-dob-er">Required field</span>
                    </div>

                    <div class="form-group">
                        <label class="control-label">Contact Number</label>
                        <input type="text" value="@Model.ContactNumber" autocomplete="off" id="pat-connum" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-connum-er">Required field</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Email Address</label>
                        <input type="text" value="@Model.EmailAddress" autocomplete="off" id="pat-email" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-email-er">Invalid Email Address</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Gender</label>
                        @if(Model.Gender == "Male")
                        {
                            <select id="pat-gender" class="form-select">
                                <option selected value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        }
                        else
                        {
                            <select id="pat-gender" class="form-select">
                                <option value="Male">Male</option>
                                <option selected value="Female">Female</option>
                            </select>
                        }

                    </div>

                    <div class="form-group">
                        <input type="submit" onclick="Next1()" value="Next" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body" style="display:none" id="b-2">
            <h3 class="text-center">Admit Patient</h3>
            <h5 class="">Step 2/4: Ward Admission</h5>
            <br />
            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label class="control-label">Ward</label>
                        <select id="ward-id" class="form-select" asp-items="ViewBag.Ward"></select>

                    </div>
                    <div class="form-group">
                        <label class="control-label">Bed</label>
                        <select id="bed-id" class="form-select" asp-items="ViewBag.Bed"></select>

                    </div>
                    
                    <div class="form-group">
                        <button type="button" value="" onclick="Prev1()" class="btn btn-primary">Previous</button>
                        <button type="button" value="Next" onclick="Next2()" class="btn btn-primary" >Next</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body" style="display:none" id="b-3">
            <h3 class="text-center">Admit Patient</h3>
            <h5 class="">Step 3/4: Patient Vitals</h5>
            <br />
            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label class="control-label">Date and Time Taken</label>
                        <input id="vit-date" required autocomplete="off" type="datetime-local" class="form-control" />

                    </div>
                    <div class="form-group">
                        <label class="control-label">Height (CM)</label>
                        <input id="pat-height" autocomplete="off" min="10" type="number" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-height-er">Out of normal range</span>

                    </div>
                    <div class="form-group">
                        <label class="control-label">Weight (KG)</label>
                        <input id="pat-weight" autocomplete="off" min="1" type="number" class="form-control" />
                        <span class="text-danger" style="display:none" id="pat-weight-er">Out of normal range</span>

                    </div>

                    @if (Model.Vitals != null)
                    {
                        foreach (var item in Model.Vitals)
                        {
                            if (!item.VitalName.ToLower().Contains("pressure"))
                            {
                                <div class="form-group">
                                    <label class="control-label">@item.Name</label>
                                    <input type="text" autocomplete="off" id="@item.VitalID" name="pat-vitals" class="form-control" />
                                    <span class="text-danger" style="display:none" id="pat-@(item.VitalID)-er">Out of normal range</span>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <label class="control-label">@item.Name</label>
                                    <div class="col-md-5">
                                        <label class="control-label">@item.VitalName:</label>
                                        <input autocomplete="off" id="@item.VitalID" name="pat-vitals" type="number" class="form-control" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="control-label">@item.VitalName2:</label>
                                        <input autocomplete="off" id="@item.VitalID" name="pat-vitals" type="number" class="form-control" />
                                    </div>
                                    <span class="text-danger" style="display:none" id="pat-@(item.VitalID)-er">Out of normal range</span>
                                </div>
                            }
                            
                        }
                    }


                    

                </div>

               
                <div class="form-group">
                    <button type="button" value="Previous" onclick="Prev2()" class="btn btn-primary">Previous</button>
                    <button type="button" value="Next" onclick="Submit()" class="btn btn-primary">Next</button>@*change back to next3()*@
                </div>
            </div>
        </div>
        <div class="card-body" style="display:none" id="b-4">
            <h3 class="text-center">Admit Patient</h3>
            <h5 class="">Step 4/4: Medical History</h5>
            <br />
            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label class="control-label">Chronic Conditions</label>
                        <select id="pat-cond" class="form-select" asp-items="ViewBag.Conditions"></select>
                        <input type="button" value="Add" onclick="AddCon()"  class="btn btn-outline-success mt-2" />
                        <div class="mt-4">
                            <table class="table w-75 table-striped">
                                <tbody id="con-list">
                                </tbody>
                                
                            </table>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Allergies</label>
                        <select id="pat-allergies" class="form-select" asp-items="ViewBag.ActiveIn"></select>
                        <input type="button" value="Add" onclick="AddAllergies()" class="btn btn-outline-success  mt-2" />
                        <div class="mt-4">
                            <table class="table w-75 table-striped">
                                <tbody id="allergies-list">
                                </tbody>

                            </table>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Medicine</label>
                        <select id="pat-meds" class="form-select" asp-items="ViewBag.Medicines"></select>
                        <input type="button" value="Add" onclick="AddMeds()" class="btn btn-outline-success mt-2" />
                        <div class="mt-4">
                            <table class="table w-75 table-striped">
                                <tbody id="meds-list">
                                </tbody>

                            </table>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" value="Previous" onclick="Prev3()" class="btn btn-primary">Previous</button>
                        <button type="submit" value="Submit" onclick="Submit()" class="btn btn-primary" >Submit</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<div class="modal fade" id="modal-center" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Addmit Patient</h5>
            </div>
            <div class="modal-body">
                <div class="text-center" id="modalbody">
                    <div class="spinner-border text-primary" id="spinner" role="status"></div><br /><span class="sr-only">Loading...</span>
                </div>
            </div>

        </div>
    </div>
</div>
@section Scripts {
@*     @if (Model.Vitals != null)
        {
            foreach (var item in Model.Vitals)
            {
               
