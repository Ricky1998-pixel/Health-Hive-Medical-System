@model IEnumerable<Health_Hive_Project_2024.Data.ViewModels.ListPre>

@{
    ViewData["Title"] = "Prescriptions";
}

@if (TempData["error"] != null)
{
    <div class="row justify-content-center">
        <div class="alert alert-danger">
            @TempData["error"]
        </div>
    </div>
}
@if (TempData["pass"] != null)
{
    <div class="row  justify-content-center">
        <div class="alert alert-success">
            @TempData["pass"]
        </div>
    </div>
}
<div class="card">
    <div class="card-body">
        
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.PatName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PatSurname)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PatIDNo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Bed)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Ward)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() == 0)
                {
                    <tr>
                        <td class="text-danger">
                            No Data Found
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.PatName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PatSurname)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PatIDNo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Bed)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Ward)
                        </td> 
                        <td>
                            @Html.DisplayFor(modelItem => item.Status)
                        </td>
                        @if (item.Status == "Dispensed" || item.Status == "Received")
                        {
                            if (item.Qty != item.QtyAd)
                            {
                                <td>
                                    <a href="@Url.Action("Administer","Nurse",new {id = item.PresId, pat = item.PatientId})" class="btn btn-outline-success">Administer</a>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <a href="@Url.Action("Administer","Nurse",new {id = item.PresId, pat = item.PatientId})" class="btn btn-outline-success">View</a>
                                </td>
                            }

                        }
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
