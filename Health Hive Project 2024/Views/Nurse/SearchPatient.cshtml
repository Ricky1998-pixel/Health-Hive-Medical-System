<div class="row justify-content-center">
    <div class="card">
        <div class="card-body">
            <form asp-action="SearchPatient" method="post">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <input type="text" autocomplete="off" placeholder="Patient ID Number" name="id" class="form-control w-50" maxlength="13">
                    </div>
                    <div class="col-md-1">
                        <input type="submit" value="Search" class="btn btn-outline-primary" />
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>