@model IEnumerable<Health_Hive_Project_2024.Models.SurgeryBooking>

@{
    ViewData["Title"] = "Bookings";
}

@if (TempData["error"] != null)
{
    <div class="row justify-content-center">
        <div class="alert alert-danger">
            @TempData["error"]
        </div>
    </div>
}
@if (TempData["pass"] != null)
{
    <div class="row  justify-content-center">
        <div class="alert alert-success">
            @TempData["pass"]
        </div>
    </div>
}
<div class="card">
    <div class="card-body">
        <div class="row justify-content-center">
            <div class="">
                <form asp-action="SearchPatientBooking" method="post">
                    <div class="row justify-content-end">
                        <div class="col-md-8">
                            <input type="text" autocomplete="off" placeholder="Patient ID Number" name="id" class="form-control w-50  float-end" maxlength="13">
                        </div>
                        <div class="col-md-2">
                            <input type="submit" value="Search" class="btn btn-outline-primary  float-end" />
                        </div>

                    </div>
                </form>

            </div>
        </div>
        <br />
        <br />
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Surgeon)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Patient)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SurgeryDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Session)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Anaesthesiologist)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Theatre)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() == 0)
                {
                    <tr>
                        <td class="text-danger">
                            No Data Found
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Surgeon.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Patient.Name)
                        </td>
                        <td>
                            @item.SurgeryDate.Date.ToString("d")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Session)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Anaesthesiologist.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Theatre.TheatreName)
                        </td>
                        @if(item.IsActive)
                        {
                            <td>
                                <a asp-action="AdmitPatient" class="btn btn-outline-success" asp-route-id="@item.SurgeryID">Admit</a>
                            </td>
                        }
                       
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            
        });
    </script>
}