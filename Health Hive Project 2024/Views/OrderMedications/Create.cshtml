@model Health_Hive_Project_2024.Models.OrderMedication

@{
    ViewData["Title"] = "Create Order";
}


<h2>Create Order</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="AnaesthesiologistName" class="control-label"></label>
        <input asp-for="AnaesthesiologistName" class="form-control" />
        <span asp-validation-for="AnaesthesiologistName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PatientName" class="control-label"></label>
        <input asp-for="PatientName" class="form-control" />
        <span asp-validation-for="PatientName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OrderDate" class="control-label"></label>
        <input asp-for="OrderDate" class="form-control" />
        <span asp-validation-for="OrderDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OrderUrgency" class="control-label"></label>
        <input asp-for="OrderUrgency" type="checkbox" class="form-check-input" />
        <span asp-validation-for="OrderUrgency" class="text-danger"></span>
    </div>

    <h4>Medications</h4>
    <div id="medications">
        <div class="form-group medication-order">
            <label>Medication Name</label>
            <select name="MedicationOrders[0].MedicationName" class="form-control">
                @foreach (var medication in ViewBag.Medications)
                {
                    <option value="@medication">@medication</option>
                }
            </select>
            <label>Quantity</label>
            <input name="MedicationOrders[0].Quantity" type="number" class="form-control" />
        </div>
    </div>

    <button type="button" id="add-medication" class="btn btn-secondary">Add Another Medication</button>
    <br />
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
    <div>
    <a asp-action="Index">Back to List</a>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            var index = 1;
            var medicationOptions = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Medications))';

            $("#add-medication").click(function() {
                var newMedication = `
                            <div class="form-group medication-order">
                                <label>Medication Name</label>
                                <select name="MedicationOrders[${index}].MedicationName" class="form-control">
                                    ${JSON.parse(medicationOptions).map(medication => `<option value="${medication}">${medication}</option>`).join('')}
                                </select>
                                <label>Quantity</label>
                                <input name="MedicationOrders[${index}].Quantity" type="number" class="form-control" />
                            </div>`;
                $("#medications").append(newMedication);
                index++;
            });
        });
    </script>
}