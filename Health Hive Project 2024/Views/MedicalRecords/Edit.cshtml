@model Health_Hive_Project_2024.Models.MedicalRecords

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>MedicalRecords</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RecordsID" />
            <div class="form-group">
                <label asp-for="AllergyID" class="control-label"></label>
                <select asp-for="AllergyID" class="form-control" asp-items="ViewBag.AllergyID"></select>
                <span asp-validation-for="AllergyID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CurrentMedication" class="control-label"></label>
                <input asp-for="CurrentMedication" class="form-control" />
                <span asp-validation-for="CurrentMedication" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

