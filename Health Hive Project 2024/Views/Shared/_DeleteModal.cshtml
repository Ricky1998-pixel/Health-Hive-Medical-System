@model Vitals

<form id="deleteForm" asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.VitalID" />
    @Html.AntiForgeryToken() <!-- Important: Anti-forgery token -->
    <p>Are you sure you want to delete this vital: <strong>@Model.Name</strong>?</p>
    <button type="submit" class="btn btn-danger">Delete</button>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
</form>
