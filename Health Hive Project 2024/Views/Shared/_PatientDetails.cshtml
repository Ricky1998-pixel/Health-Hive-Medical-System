@* @model Health_Hive_Project_2024.Models.Patient *@
@model Health_Hive_Project_2024.ViewModels.PatientDetailsViewModel

@{
    ViewData["Title"] = "Patient Details";
}

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<!-- Include jQuery and Bootstrap JavaScript -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<style>
    #patient-details {
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 20px;
        background-color: #f9f9f9;
        margin-top: 20px;
    }

        #patient-details p {
            margin: 0;
            padding: 5px 0;
        }

            #patient-details p strong {
                color: #333;
            }

        #patient-details .patient-info {
            margin-top: 10px;
        }

    .not-found {
        color: #dc3545;
        font-weight: bold;
    }

    .btn-container {
        margin-top: 20px;
        display: flex;
        gap: 10px; /* Adjust spacing between buttons */
    }

        .btn-container .btn {
            font-size: 0.875rem; /* Smaller font size */
            padding: 0.5rem 1rem; /* Smaller padding */
        }

    .medical-history-section {
        margin-top: 15px;
    }

        .medical-history-section h6 {
            margin-bottom: 5px;
        }
</style>



<div class="modal fade" id="alertsModal" tabindex="-1" role="dialog" aria-labelledby="alertsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="alertsModalLabel">Alerts</h5>
                <img src="~/images/Prescription Alert.gif" alt="Success GIF" style="width: 80px; height: 80px;" />
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modal-alerts-body">
                <!-- Add your GIF here, replacing the icon -->
                <img src="~/images/Prescription Alert.gif" alt="Success GIF" style="width: 80px; height: 80px;" />
                <!-- Alerts will be populated here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div id="patient-details">

    <div id="alertContainer">
        @if (Model.Alerts.Any())
        {
            <div class="alert alert-warning">
                <ul>
                    @foreach (var alert in Model.Alerts)
                    {
                        <li>@alert</li>
                    }
                </ul>
            </div>
        }
    </div>



    @if (Model.Patient != null)
    {
        <input type="hidden" id="selectedPatientId" name="PatientID" value="@Model.Patient.PatientID" />
        <div class="patient-info">
            <p><strong>ID Number:</strong> @Model.Patient.PatientIDNumber</p>
            <p><strong>Name:</strong> @Model.Patient.Name @Model.Patient.Surname</p>
            <p><strong>Address:</strong> @Model.Patient.Address</p>
            <p><strong>Contact Number:</strong> @Model.Patient.ContactNumber</p>
            <p><strong>Email Address:</strong> @Model.Patient.EmailAddress</p>
            <p><strong>Date of Birth:</strong> @Model.Patient.DateOfBirth.ToString("yyyy-MM-dd")</p>
            <p><strong>Gender:</strong> @Model.Patient.Gender</p>

            @* Display Medical History *@
            
        </div>

        <div class="btn-container">
            <a href="#" class="btn btn-primary showVitals" data-id="@Model.Patient.PatientID">Patient Vitals</a>

            <a href="#" id="showMedicalHistory" data-id="@Model.Patient.PatientID" class="btn btn-primary">Patient Medical History</a>
        </div>
    }
    else
    {
        <p class="not-found">
            Patient not found.
            <a href="~/Patients/Create" class="btn btn-primary ml-2">Add Patient</a>
        </p>
    }
</div>


<!-- Modal Structure: Patient Vital History -->
<div class="modal fade" id="patientVitalsModal" tabindex="-1" role="dialog" aria-labelledby="patientVitalsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientVitalsModalLabel">Patient Vital History</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="patientVitalsContent">
                    <!-- Content will be dynamically loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Structure: Patient Medical History -->
<div class="modal fade" id="medicalHistoryModal" tabindex="-1" role="dialog" aria-labelledby="medicalHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="medicalHistoryModalLabel">Patient Medical History</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="patientMedicalHistoryContent">
                    <!-- Content will be dynamically loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Event handler for the "Patient Vitals" button
        $(document).ready(function () {
            $('.showVitals').on('click', function (e) {
                e.preventDefault();
                var patientId = $(this).data('id');

                // Show loading indicator
                $('#patientVitalsContent').html('<div class="text-center"><div class="spinner-border" role="status"><span class="sr-only">Loading...</span></div></div>');

                // Show the modal
                $('#patientVitalsModal').modal('show');

                // Fetch the partial view
                $.ajax({
                    url: '/PatientVitals/GetPatientVitals',
                    data: { id: patientId },
                    type: 'GET',
                    success: function (result) {
                        $('#patientVitalsContent').html(result);
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX error: " + status + ": " + error);
                        $('#patientVitalsContent').html('<div class="alert alert-danger">Error loading patient vitals. Please try again later.</div>');
                    }
                });
            });
        });

        // Event handler for the "Patient Medical History" button
        $('#showMedicalHistory').on('click', function (e) {
            e.preventDefault(); // Prevent default link behavior

            var patientId = $(this).data('id'); // Get the patient ID from the button's data attribute

            // Make an AJAX request to fetch the patient's medical history
            $.ajax({
                url: '@Url.Action("GetPatientMedicalHistory", "MedicalHistories")', // Updated URL to match your controller and action
                type: 'GET',
                data: { id: patientId },
                success: function (data) {
                    // Load the response into the modal body
                    $('#patientMedicalHistoryContent').html(data);

                    // Show the modal
                    $('#medicalHistoryModal').modal('show');
                },
                error: function (xhr, status, error) {
                    console.error('An error occurred:', error);
                    alert('An error occurred while fetching the patient\'s medical history. Please try again.');
                }
            });
        });
    });
</script>








