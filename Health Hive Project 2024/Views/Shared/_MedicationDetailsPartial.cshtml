 @model Health_Hive_Project_2024.Models.MedicationRecords

@{
    // Sanitize the medication name to remove spaces and convert to lowercase
    var sanitizedMedicationName = Model.MedicationName.Replace(" ", "").ToLower();
    // Check possible image paths
    var imagePathJpg = $"/images/{sanitizedMedicationName}.jpg";
    var imagePathJpeg = $"/images/{sanitizedMedicationName}.jpeg";
    // Default image if neither exists
    var defaultImagePath = "/images/default-image.jpg";
}

<div class="modal-header">
    <h5 class="modal-title">Medication Details</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <!-- Use the sanitized medication name to construct the image path -->
    <img id="medicationImage" src="@imagePathJpg" alt="Medication Image" style="width: 300px; height: auto;" onerror="this.onerror=null; this.src='@defaultImagePath';">

    <div id="medicationDetails">
        <h4>@Model.MedicationName</h4>
        <dl class="row">
            <dt class="col-sm-2">Dosage Form</dt>
            <dd class="col-sm-10">@Model.DosageForm.Form</dd>
            <dt class="col-sm-2">Schedule</dt>
            <dd class="col-sm-10">@Model.Schedule</dd>
            <dt class="col-sm-2">Quantity On Hand</dt>
            <dd class="col-sm-10">@Model.QuantityOnHand</dd>
            <dt class="col-sm-2">ReOrder Level</dt>
            <dd class="col-sm-10">@Model.ReOrderLevel</dd>
        </dl>
    </div>
</div>

