<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health Hive Home</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Boxicons CSS -->
    <link href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css" rel="stylesheet">
    <link href="~/css/NavigationMenu.css" rel="stylesheet"> <!-- Link to external CSS file -->
    <link href="~/css/vertical-layout-light/style.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/c7f32021bc.js" crossorigin="anonymous"></script>
    <style>
        .nav_logo-icon {
            width: 24px; /* Adjust the width of the icon */
            height: 24px; /* Adjust the height of the icon */
            margin-right: 8px; /* Space between the icon and the text */
            vertical-align: middle; /* Align the icon with the text */
        }

    </style>

    <!--Logout Button Style-->
    <style>
        /* CSS for the circular button */
        .btn-circle {
            border-radius: 50%; /* Make the button circular */
            width: 50px; /* Adjust width to desired size */
            height: 50px; /* Adjust height to match width for the circle */
            padding: 0; /* Remove padding for a perfect circle */
            display: flex; /* Center the text inside */
            justify-content: center;
            align-items: center;
            font-size: 14px; /* Adjust text size */
            color: white; /* Make the text white */
        }

        .btn-danger {
            background-color: red; /* Red background for the danger class */
            border: none; /* Remove border */
        }

            .btn-danger:hover {
                background-color: darkred; /* Slightly darker red on hover */
            }

    </style>
</head>
@inject IHttpContextAccessor HttpContextAccessor
<body id="body-pd">
    <header class="header" id="header">
        <div class="header_toggle"> <i class='bx bx-menu' id="header-toggle"></i> </div>
        @*new code for showing logout details*@
        <div class="nav-auth">
            <ul class="nav" style="flex-direction:row;">
                @if (User.Identity.IsAuthenticated)
                {
                   
                    <li class="nav-item">
                        <a class="nav-link text-dark d-flex align-items-center" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                            <img src="~/images/hello user.png" alt="Manage Icon" class="nav_icon" />
                           
                            <span class="ml-2">Hello @HttpContextAccessor.HttpContext.Session.GetString("user_name") @HttpContextAccessor.HttpContext.Session.GetString("user_surname")</span>
                        </a>
                            <a asp-action="Logout" asp-controller="Allergies" class="nav-link btn btn-danger">Logout</a>
                        @* <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="nav-link btn btn-danger">Logout</button>
                        </form>*@
                    </li>
                }
            </ul>
        </div>

    </header>
    <div class="l-navbar" id="nav-bar">
        <nav class="nav">
            <div>

                @if (User.Identity.IsAuthenticated)
                {
                    <a class="nav_logo d-flex align-items-center disabled">
                        <img src="~/images/home.png" alt="Home Icon" class="nav_logo-icon" />
                        <span class="nav_logo-name">Health Hive Pharmacy</span>
                    </a>
                }
                else
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="nav_logo d-flex align-items-center">
                        <img src="~/images/home.png" alt="Home Icon" class="nav_logo-icon" />
                        <span class="nav_logo-name">Health Hive Pharmacy</span>
                    </a>
                }


                <div class="nav_list">
                    @await Html.PartialAsync("_LoginPartial")

                </div>
            </div>
        </nav>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            <br />
            <br />
            <br />
            <br />
            @RenderBody() <!-- Placeholder for dynamic content -->
        </main>
    </div>
    <!-- Scripts section -->
    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script src="~/js/NavigationMenu.js"></script> <!-- Link to external JavaScript file -->
    @RenderSection("Scripts", required: false)
    <script>
        function OpenLink() {
            $('#modal-d-report').modal("show")
        }
    </script>
    
</body>
</html>




