<div class="modal fade" style="z-index: 5;" id="modal-d-report" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Report</h5>
                </div>
                <div class="modal-body">
                    <form asp-action="Report" asp-controller="Nurse" method="post">
                        <div class="row">
                            <h5>Date range</h5>
                            <div class="col-6">
                                <div class="form-group">
                                    <label class="control-label">Date From:</label>
                                    <input type="date" name="f" class="form-control" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label class="control-label">Date To:</label>
                                    <input type="date" name="t" class="form-control" />
                                </div>
                            </div>

                        </div>
                    </form>
                    

                </div>

            </div>
        </div>
    </div>

