@{
    ViewData["Title"] = "Chat";
}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background-color: #e5ddd5;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        overflow: hidden;
    }

    .chat-container {
        display: flex;
        height: 80vh;
        width: 90vw;
        max-width: 1200px;
        background-color: #ffffff;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .sidebar {
        width: 300px;
        background-color: #f8f9fa;
        border-right: 1px solid #ddd;
        padding: 10px;
        overflow-y: auto;
        border-top-left-radius: 20px;
        border-bottom-left-radius: 20px;
    }

    .user-list {
        list-style: none;
        padding: 0;
    }

    .user-item {
        display: flex;
        align-items: center;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .user-item:hover {
            background-color: #e0e0e0;
        }

        .user-item img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-right: 15px;
        }

    .chat-window {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 20px;
        background-color: #ffffff;
    }

    #chatHeader {
        border-bottom: 1px solid #ddd;
        padding-bottom: 10px;
        display: flex;
        align-items: center;
        background-color: #f1f1f1;
        border-top-right-radius: 20px;
        border-top-left-radius: 20px;
    }

        #chatHeader h2 {
            margin: 0;
            font-size: 18px;
        }

    .messages-list {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
        background-color: #f9f9f9;
        border-radius: 10px;
    }

    .message {
        padding: 10px;
        border-radius: 10px;
        margin-bottom: 10px;
        max-width: 70%;
        word-wrap: break-word;
    }

        .message.sent {
            background-color: #dcf8c6;
            align-self: flex-end;
        }

        .message.received {
            background-color: #ffffff;
            align-self: flex-start;
        }

    #messageInput {
        width: calc(100% - 90px);
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #ddd;
    }

    #sendMessageButton {
        width: 80px;
        padding: 10px;
        border: none;
        border-radius: 10px;
        background-color: #007bff;
        color: #ffffff;
        cursor: pointer;
        font-size: 16px;
    }

        #sendMessageButton:hover {
            background-color: #0056b3;
        }
</style>

<div class="chat-container">
    <!-- Sidebar for Users -->
    <div class="sidebar">
        <h3>Users</h3>
        <ul id="userList" class="user-list">
            @foreach (var user in ViewBag.Users)
            {
                <li class="user-item" onclick="openChat('@user.UserName')">
                    <img src="/images/user-icon.png" alt="@user.UserName" />
                    <span>@user.UserName</span>
                </li>
            }
        </ul>
    </div>

    <!-- Chat Window -->
    <div class="chat-window">
        <div id="chatHeader">
            <h2 id="chatTitle">Select a user to start chatting</h2>
        </div>
        <div id="messagesList" class="messages-list"></div>
        <div style="display: flex; align-items: center; margin-top: 10px;">
            <input type="text" id="messageInput" placeholder="Type a message" />
            <button id="sendMessageButton">Send</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.2/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub")
            .build();

        connection.on("ReceiveMessage", (sender, message) => {
            const msg = document.createElement("div");
            msg.className = sender === document.getElementById("chatTitle").textContent ? "message sent" : "message received";
            msg.textContent = `${sender}: ${message}`;
            document.getElementById("messagesList").appendChild(msg);
        });

        connection.on("UpdateUserList", (users) => {
            const userList = document.getElementById("userList");
            userList.innerHTML = "";
            users.forEach(user => {
                const userItem = document.createElement("li");
                userItem.classList.add("user-item");
                userItem.innerHTML = `
                            <img src="/images/user-icon.png" alt="${user.UserName}" />
                            <span>${user.UserName}</span>
                        `;
                userItem.onclick = () => {
                    openChat(user.UserName);
                };
                userList.appendChild(userItem);
            });
        });

        document.getElementById("sendMessageButton").addEventListener("click", () => {
            const message = document.getElementById("messageInput").value;
            const recipient = document.getElementById("chatTitle").textContent;
            connection.invoke("SendMessage", recipient, message).catch(err => console.error(err.toString()));
            document.getElementById("messageInput").value = "";
        });

        function openChat(userName) {
            document.getElementById("chatTitle").textContent = userName;
            // Load chat history if needed
        }

        connection.start().catch(err => console.error(err.toString()));
    </script>
}








