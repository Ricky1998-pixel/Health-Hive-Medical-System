@model IEnumerable<Health_Hive_Project_2024.Models.RejectedPrescription>

@{
    ViewData["Title"] = "Index";
}

<h1>Prescription Records</h1>

@{
    var groupedPrescriptions = Model.GroupBy(p => p.PrescriptionID);
}

<div class="container">
    @foreach (var group in groupedPrescriptions)
    {
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5>Prescription ID: @group.Key</h5> <!-- Group by PrescriptionID -->
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <strong>Surgeon:</strong> @group.First().Surgeon.Name @group.First().Surgeon.Surname
                    </div>
                    <div class="col-md-6">
                        <strong>Pharmacist:</strong> @group.First().Pharmacist.Name @group.First().Pharmacist.Surname
                    </div>
                    <div class="col-md-6">
                        <strong>Patient:</strong> @group.First().Patient.Name @group.First().Patient.Surname
                    </div>
                </div>

                <!-- Display medications in sub-sections -->
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        <h6>Medications</h6>
                        <ul class="list-group">
                            @foreach (var item in group)
                            {
                                <li class="list-group-item">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <strong>Medication:</strong> @item.Medication.MedicationName
                                        </div>
                                        <div class="col-md-2">
                                            <strong>Quantity:</strong> @item.Quantity
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Instructions:</strong> @item.Instructions
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Display rejection info -->
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <strong>Rejection Reason:</strong> @group.First().RejectionReason
                    </div>
                    <div class="col-md-6">
                        <strong>Rejected On:</strong> @group.First().RejectedOn.ToShortDateString()
                    </div>
                </div>

                <!-- Action Links -->
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        <a asp-action="Edit" asp-route-id="@group.First().RejectedPrescriptionID" class="btn btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@group.First().RejectedPrescriptionID" class="btn btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@group.First().RejectedPrescriptionID" class="btn btn-danger">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

