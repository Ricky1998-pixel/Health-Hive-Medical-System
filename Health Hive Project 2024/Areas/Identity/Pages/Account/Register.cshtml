@page
@model RegisterModel
@{
    ViewData["Title"] = "Admin Registration";
}

<link href="~/css/AdminRegistration.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


<style>
    body {
        background-image: url('/images/pexels-karolina-grabowska-4467739.jpg');
        background-size: cover;
        background-position: center;
    }

    .form-container {
        background-color: rgba(255, 255, 255, 0.9);
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .form-floating {
        margin-bottom: 1rem;
    }

        .form-floating label {
            color: #333; /* Ensure label color is visible */
            font-size: 1rem;
        }

    .form-control {
        border-radius: 0.5rem;
    }

    .btn-primary {
        border-radius: 0.5rem;
    }

    .text-center {
        text-align: center;
    }

    .step {
        display: none;
    }

        .step.active {
            display: block;
        }

    .step-finish {
        display: none;
    }

    .step.active ~ .step-finish {
        display: block;
    }

    .progress-indicator {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
    }

        .progress-indicator div {
            width: 10px;
            height: 10px;
            background-color: #ccc;
            border-radius: 50%;
            margin: 0 5px;
        }

        .progress-indicator .active {
            background-color: #007bff;
        }


    .title-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px; /* Adjust the space between image and text */
    }

    .title-image {
        width: 50px; /* Adjust the image size */
        height: auto;
    }

    .title-text {
        margin: 0; /* Remove default margin */
    }

    .section-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px; /* Adjust the space between image and text */
    }

    .section-image {
        width: 30px; /* Adjust the image size */
        height: auto;
    }

    .section-text {
        margin: 0; /* Remove default margin */
    }

    .address-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px; /* Adjust the space between image and text */
    }

    .address-image {
        width: 30px; /* Adjust the image size */
        height: auto;
    }

    .address-text {
        margin: 0; /* Remove default margin */
    }

    .account-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px; /* Adjust the space between image and text */
    }

    .account-image {
        width: 30px; /* Adjust the image size */
        height: auto;
    }

    .account-text {
        margin: 0; /* Remove default margin */
    }

    .btn-pink {
        background-color: pink; /* Set the background color to pink */
        color: white; /* Ensure text color contrasts well with the background */
        border: none; /* Remove default border if needed */
    }

        .btn-pink:hover {
            background-color: lightcoral; /* Optional: Change color on hover */
        }

        .btn-pink i {
            margin-right: 8px; /* Optional: Adjust spacing between icon and text */
        }

    label img {
        width: 20px; /* Adjust the width of the image */
        height: 20px; /* Adjust the height of the image */
        margin-right: 5px; /* Space between the image and text */
        vertical-align: middle; /* Align image with text */
    }
</style>


<div class="title-container text-center">
    <img src="/images/admin registration.png" alt="Your Image" class="title-image" />
    <h1 class="title-text">@ViewData["Title"]</h1>
</div>


<div class="row justify-content-center">
    <div class="col-md-6 form-container">
        <div class="progress mb-4">
            <div class="progress-bar" role="progressbar" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100" style="width: 33%"></div>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="needs-validation" novalidate>
            <div class="step active" id="step1">
                <div class="section-title text-center mb-4">
                    <img src="/images/personal information.png" alt="Your Image" class="section-image" />
                    <h2 class="section-text">Personal Information</h2>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Input.Title" class="control-label">
                        <img src="/images/title.png" alt="Title Icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Title
                    </label>

                    <select asp-for="Input.Title" asp-items="Model.Input.TitleOptions" class="form-control" required></select>

                    <span asp-validation-for="Input.Title" class="text-danger"></span> <!-- This will display the validation message -->
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Name" class="form-control" aria-required="true" placeholder="Name" required />
                    <label asp-for="Input.Name">
                        <img src="~/images/name registration.png" alt="icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Name
                    </label>

                    <div class="invalid-feedback">Please provide a valid name.</div>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Surname" class="form-control" aria-required="true" placeholder="Surname" required />
                    <label asp-for="Input.Surname">
                        <img src="~/images/name registration.png" alt="icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Surname
                    </label>

                    <div class="invalid-feedback">Please provide a valid surname.</div>
                </div>
                <button type="button" class="w-100 btn btn-primary" onclick="nextStep(1)">
                    <i class="fa-solid fa-circle-arrow-right"></i> Next
                </button>

            </div>

            <div class="step" id="step2">
                <div class="address-title text-center mb-4">
                    <img src="/images/address information.png" alt="Your Image" class="address-image" />
                    <h2 class="address-text">Address Information</h2>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Address" class="form-control" aria-required="true" placeholder="Address" required />
                    <label asp-for="Input.Address">
                        <img src="/images/address.png" alt="Address Icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Address
                    </label>

                    <div class="invalid-feedback">Please provide a valid address.</div>
                </div>
                <div class="form-floating mb-3">
                    <input id="PostalCode" asp-for="Input.PostalCode" class="form-control" aria-required="true" placeholder="Postal Code" required />
                    <label asp-for="Input.PostalCode">
                        <img src="/images/postal code.png" alt="Postal Code Icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Postal Code

                    </label>
                    <br />
                   



                    <div class="invalid-feedback">Please provide a valid postal code.</div>
                </div>
                <div class="form-floating mb-3">
                <input id="ContactNumber" asp-for="Input.ContactNumber" class="form-control" aria-required="true" placeholder="" required />
                <label asp-for="Input.ContactNumber">
                    <img src="/images/Cell.png" alt="Postal Code Icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                    ContactNumber
                </label>
                </div>

                <div class="form-group mb-3">
                    <label for="Suburb">
                       
                    </label>

                    <select id="Suburb" class="form-control" aria-required="true" required>
                        <option value="">-- Select Suburb --</option>
                    </select>
                    <div class="invalid-feedback">Please select a suburb.</div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input id="City" asp-for="Input.City" class="form-control" aria-required="true" placeholder="City" required />
                            <label asp-for="Input.City">
                                <img src="/images/city.png" alt="City Icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                                City
                            </label>

                            <div class="invalid-feedback">Please provide a valid city.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input id="Province" asp-for="Input.Province" class="form-control" aria-required="true" placeholder="Province" required />
                            <label asp-for="Input.Province">
                                <img src="/images/province.png" alt="Province Icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                                Province
                            </label>

                            <div class="invalid-feedback">Please provide a valid province.</div>
                        </div>
                    </div>
                </div>
                <button type="button" class="w-100 btn btn-pink" onclick="previousStep(2)">
                    <i class="fa-solid fa-circle-arrow-left"></i>Back
                </button>
                <button type="button" class="w-100 btn btn-primary" onclick="nextStep(2)">
                    <i class="fa-solid fa-circle-arrow-right"></i>Next
                </button>
            </div>

            <div class="step" id="step3">
                <div class="account-title text-center mb-4">
                    <img src="/images/account information.png" alt="Your Image" class="account-image" />
                    <h2 class="account-text">Account Information</h2>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" required />
                    <label asp-for="Input.Email">
                        <img src="~/images/email registration.png" alt="icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Email
                    </label>

                    <div class="invalid-feedback">Please provide a valid email.</div>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" required />
                    <label asp-for="Input.Password">
                        <img src="~/images/password.png" alt="icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Password
                    </label>

                    <div class="invalid-feedback">Please provide a valid password.</div>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" required />
                    <label asp-for="Input.ConfirmPassword">
                        <img src="~/images/confirm password.png" alt="icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Confirm Password
                    </label>

                    <div class="invalid-feedback">Please confirm your password.</div>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.HealthCouncilRegistrationNumber" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Health Council Registration Number" required value="admin" />
                    <label asp-for="Input.HealthCouncilRegistrationNumber">
                        <img src="~/images/confirm password.png" alt="icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Health Council Registration Number
                    </label>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Role" class="control-label">
                        <img src="~/images/role.png" alt="icon" style="width: 20px; height: 20px; margin-right: 5px;" />
                        Role
                    </label>

                    <!-- Set the select to be disabled so the user can't change the role -->
                    <select asp-for="Input.Role" class="form-control" disabled>
                        <option value="Admin">Admin</option> <!-- Default Admin role -->
                    </select>

                    <!-- Hidden input to submit the role value to the server -->
                    <input type="hidden" asp-for="Input.Role" value="Admin" />

                    <div class="invalid-feedback">Please select a role.</div>
                </div>

                <button type="button" class="w-100 btn btn-pink" onclick="previousStep(3)">
                    <i class="fa-solid fa-circle-arrow-left"></i>Back
                </button>
                <button type="submit" class="w-100 btn btn-primary">
                    <i class="fa-solid fa-registered"></i>Register
                </button>
            </div>
        </form>
    </div>
</div>




<script>
    function updateProgress(step) {
        // Calculate the percentage based on the current step
        var percentage;

        switch (step) {
            case 1:
                percentage = 33.33; // First step
                break;
            case 2:
                percentage = 66.67; // Second step
                break;
            case 3:
                percentage = 100; // Final step
                break;
            default:
                percentage = 0; // Default to 0%
        }

        var progressBar = document.querySelector('.progress-bar');
        progressBar.style.width = percentage + '%';
        progressBar.setAttribute('aria-valuenow', percentage);
    }

    function nextStep(step) {
        var currentStep = document.getElementById('step' + step);
        var nextStep = document.getElementById('step' + (step + 1));

        currentStep.classList.remove('active');
        nextStep.classList.add('active');

        updateProgress(step + 1); // Update progress for the next step
    }

    function previousStep(step) {
        var currentStep = document.getElementById('step' + step);
        var previousStep = document.getElementById('step' + (step - 1));

        currentStep.classList.remove('active');
        previousStep.classList.add('active');

        updateProgress(step - 1); // Update progress for the previous step
    }

</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const postalCodeInput = document.getElementById('PostalCode');
        const suburbDropdown = document.getElementById('Suburb');
        const cityInput = document.getElementById('City');
        const provinceInput = document.getElementById('Province');

        // Data for suburbs, cities, and provinces
        const data = {
            "1200": [
                { suburb: "Kamagugu", city: "Mbombela", province: "Mpumalanga" }
            ],
            "1300": [
                { suburb: "Barberton", city: "Mbombela", province: "Mpumalanga" }
            ],
            "1226": [
                { suburb: "Riverside", city: "Mbombela", province: "Mpumalanga" }
            ],
            "4001": [
                { suburb: "Essenwood", city: "Durban", province: "KwaZulu-Natal" },
                { suburb: "Musgrave", city: "Durban", province: "KwaZulu-Natal" },
                { suburb: "Greyville", city: "Durban", province: "KwaZulu-Natal" },
                { suburb: "Glenmore", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "6025": [
                { suburb: "Bridgemead", city: "Gqeberha", province: "Eastern Cape" }
            ],
            "4051": [
                { suburb: "Kenville", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "6001": [
                { suburb: "Humewood", city: "Gqeberha", province: "Eastern Cape" },
                { suburb: "Algoa Park", city: "Gqeberha", province: "Eastern Cape" },
                { suburb: "Struandale", city: "Gqeberha", province: "Eastern Cape" },
                { suburb: "Summerstrand", city: "Gqeberha", province: "Eastern Cape" }
            ],
            "4091": [
                { suburb: "Cato Manor", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "4052": [
                { suburb: "Bluff", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "6045": [
                { suburb: "Cotswold", city: "Gqeberha", province: "Eastern Cape" }
            ],
            "6070": [
                { suburb: "Lorraine", city: "Gqeberha", province: "Eastern Cape" }
            ],
            "4359": [
                { suburb: "Kwamashu", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "4309": [
                { suburb: "Inanda", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "1201": [
                { suburb: "Valencia Park", city: "Mbombela", province: "Mpumalanga" }
            ],
            "4399": [
                { suburb: "Tongaat", city: "Durban", province: "KwaZulu-Natal" }
            ],
            "6020": [
                { suburb: "Malabar", city: "Gqeberha", province: "Eastern Cape" }
            ]
        };

        postalCodeInput.addEventListener('input', () => {
            const postalCode = postalCodeInput.value;
            const infoList = data[postalCode] || [];

            // Clear the dropdown first
            suburbDropdown.innerHTML = '<option value="">-- Select Suburb --</option>';

            if (infoList.length === 1) {
                // If only one suburb is available, auto-fill it
                const info = infoList[0];
                suburbDropdown.innerHTML = `<option value="${info.suburb}">${info.suburb}</option>`;
                suburbDropdown.value = info.suburb;
                cityInput.value = info.city;
                provinceInput.value = info.province;
                suburbDropdown.disabled = true; // Disable dropdown since there's only one option
            } else if (infoList.length > 1) {
                // If multiple suburbs are available, populate the dropdown
                infoList.forEach(info => {
                    const option = document.createElement('option');
                    option.value = info.suburb;
                    option.textContent = info.suburb;
                    suburbDropdown.appendChild(option);
                });
                cityInput.value = infoList[0].city; // Default city
                provinceInput.value = infoList[0].province; // Default province
                suburbDropdown.disabled = false; // Enable dropdown if there are multiple options
            } else {
                // No information available
                cityInput.value = '';
                provinceInput.value = '';
                suburbDropdown.disabled = true; // Disable dropdown if no info is available
            }
        });

        suburbDropdown.addEventListener('change', () => {
            const selectedSuburb = suburbDropdown.value;
            const postalCode = postalCodeInput.value;
            const infoList = data[postalCode] || [];

            const selectedInfo = infoList.find(info => info.suburb === selectedSuburb);
            if (selectedInfo) {
                cityInput.value = selectedInfo.city;
                provinceInput.value = selectedInfo.province;
            } else {
                cityInput.value = '';
                provinceInput.value = '';
            }
        });
    });
</script>




